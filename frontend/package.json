{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/butler/frontend/ && yarn copy-html-entry",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "copy-html-entry": "cp ../butler/public/frontend/index.html ../butler/www/butler.html"
  },
  "dependencies": {
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "frappe-ui": "^0.1.261",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^2.2.6",
    "socket.io-client": "^4.7.2",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "vue-sonner": "^1.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^2.1.10"
  }
}
